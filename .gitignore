.opencode/skills/
.claude/skills/
.github/skills/
.agents/skills/
.cursor/skills/
# per-machine resolution of skill layers (depends on ~/.config/aix)
.aix/index.json
# usual suspects
__pycache__/
*.pyc
.venv/
node_modules/
.env
.env.*
!.env.example
# presentations and other binaries do not belong in the kit
*.pdf
*.pptx
.github/instructions/aix-*.instructions.md
.cursor/rules/aix-*.mdc
