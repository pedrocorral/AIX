# Every variable the app reads, with a comment. No values for secrets.
APP_ENV=local                      # local | test | staging | prod
PERSISTENCE_BACKEND=memory         # memory | sqlite | postgres | mongo (see docs/meta-docs/persistence/switching-backends.md)
DATABASE_URL=                      # required unless PERSISTENCE_BACKEND=memory
SECRET_KEY=                        # required; ≥ 32 random bytes; never commit
LOG_LEVEL=INFO
