#!/usr/bin/env bash
# aix launcher for Linux / macOS. All logic lives in scripts/aix.py (Python 3.9+, no dependencies).
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
py="$(command -v python3 || command -v python || true)"
[ -n "$py" ] || { echo "aix: python3 not found" >&2; exit 127; }
exec "$py" "$here/scripts/aix.py" "$@"
